# ViDo NestJS Backend Configuration
# ==============================================================================

# Database Connection (Default: local SQLite database file)
DATABASE_URL="file:./dev.db"

# Production PostgreSQL example:
# DATABASE_URL="postgresql://user:password@localhost:5432/vido?schema=public"

# HTTP Port
PORT=3001

# Node Environment
NODE_ENV=development

# Firebase Auth Configuration (Optional for local development)
# When omitted in development, automatically connects to emulator on 127.0.0.1:9099
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_PROJECT_ID=demo-vido
