# ViDo Firebase Configuration (Optional for local development)
# When omitted, ViDo defaults to demo mode and connects to the local Firebase Auth Emulator on port 9099.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" to force connection to local Firebase Auth Emulator on port 9099
VITE_USE_FIREBASE_EMULATOR=false

# ==============================================================================
# Backend Architecture Configuration
# ==============================================================================
# Options:
#   "nestjs" - Connects to the local NestJS backend API on port 3001
#   "mock"   - Uses browser-based MockTeamRepository with dev server sync bridge
VITE_BACKEND_TYPE=nestjs

# Custom API base URL (defaults to '' using Vite proxy to http://localhost:3001)
VITE_API_URL=

# ==============================================================================
# Supabase Integration (Optional - for production BaaS)
# ==============================================================================
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
